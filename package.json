{
  "name": "camera-archive",
  "version": "1.0.0",
  "description": "Capacity-managed NVR snapshot archive",
  "private": true,
  "main": "src/app.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env onvif.js",
    "test": "node --test --test-timeout=60000 test/integration/*.test.js",
    "test:browser": "playwright test",
    "check:syntax": "node scripts/check-syntax.js",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run check:syntax && npm run lint && npm run format:check && npm test",
    "calibrate": "node src/retention/calibrate.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "argon2": "0.45.1",
    "better-sqlite3": "13.0.3",
    "digest-fetch": "3.1.1",
    "express": "5.3.0",
    "gsap": "^3.15.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "axe-core": "^4.14.0",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10"
  }
}
